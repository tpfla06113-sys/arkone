{
  "name": "sangok",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // sangokxi.com 과 www 를 이 Worker에 바로 연결 (같은 Cloudflare 계정에 도메인이 있어야 함)
  "routes": [
    { "pattern": "sangokxi.com", "custom_domain": true },
    { "pattern": "www.sangokxi.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // 공개해도 되는 값만 여기에. API Key·Secret·알림 받을 번호는 대시보드 Secret으로
  "vars": { "CUSTOMER_SMS": "off" },
  "keep_vars": true,
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
